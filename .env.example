# Python AI service. LLM_API_KEY is needed only for explicitly enabled live calls.
LLM_API_KEY=
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=qwen/qwen3.8-flash
AI_SERVICE_TOKEN=
CORPUS_PATH=data/demo_sources.json

# Backend defaults. Compose injects its own in-network paths and AI_BASE_URL.
AUTH_MODE=demo
DEMO_PROFILE=intern
AI_MODE=replay
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://navigator:navigator@postgres:5432/navigator?sslmode=disable
AI_BASE_URL=http://ai:8001
AI_REQUEST_TIMEOUT=310s
WORKER_CONCURRENCY=1
JOB_LEASE=60s
JOB_HEARTBEAT=15s
JOB_MAX_ATTEMPTS=2
JIRA_BASE_URL=https://demo-jira.local
SEED_PATH=data/demo_tasks.json
REPLAY_DIR=examples/recorded
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8080
AI_PORT=8001
POSTGRES_PORT=5433
POSTGRES_DB=navigator
POSTGRES_USER=navigator
POSTGRES_PASSWORD=navigator
