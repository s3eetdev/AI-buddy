{
  "openapi": "3.1.0",
  "info": {
    "title": "AI-buddy Task Navigator",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_v1_analyze_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Task Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 16000,
            "title": "Description",
            "default": ""
          },
          "acceptance_criteria": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Acceptance Criteria"
          },
          "allowed_scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allowed Scopes"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "title": "Question",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "title",
          "allowed_scopes"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "needs_clarification",
              "insufficient_context"
            ],
            "title": "Status"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "usage": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Usage"
          },
          "jira_markdown": {
            "type": "string",
            "title": "Jira Markdown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "status",
          "plan",
          "sources",
          "model",
          "usage",
          "jira_markdown"
        ],
        "title": "AnalyzeResponse"
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          },
          "quote": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "start_line",
          "end_line",
          "quote"
        ],
        "title": "Citation"
      },
      "Finding": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "hypothesis"
            ],
            "title": "Kind"
          },
          "role": {
            "type": "string",
            "enum": [
              "entry_point",
              "change_candidate",
              "context",
              "relationship"
            ],
            "title": "Role"
          },
          "explanation": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Explanation"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "role",
          "explanation"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Plan": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Summary"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Findings"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Steps"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Questions"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "findings",
          "steps",
          "questions",
          "limitations"
        ],
        "title": "Plan"
      },
      "Source": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "documentation",
              "contract",
              "test",
              "catalog"
            ],
            "title": "Kind"
          },
          "content": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "scope",
          "path",
          "kind",
          "content"
        ],
        "title": "Source"
      },
      "Step": {
        "properties": {
          "action": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Action"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Source Ids"
          },
          "expected_result": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Expected Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "expected_result"
        ],
        "title": "Step"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
